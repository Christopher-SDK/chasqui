# nginx de la demo: panel estático + proxy a los simuladores del mismo contenedor.
server {
  listen ${PORT};
  root /repo/apps/panel/dist;
  add_header X-Robots-Tag "noindex" always;

  location /sunat/ {
    rewrite ^/sunat/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:7100;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }
  location /pagos/ {
    rewrite ^/pagos/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:7200;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_read_timeout 1h;
  }
  location /identidad/ {
    rewrite ^/identidad/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:7300;
  }
  location /caos/ {
    rewrite ^/caos/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:7400;
  }
  location = /salud { return 200 'ok'; add_header Content-Type text/plain; }
  location / { try_files $uri /index.html; }
}
