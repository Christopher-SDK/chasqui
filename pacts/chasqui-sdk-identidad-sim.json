{
  "consumer": {
    "name": "chasqui-sdk"
  },
  "interactions": [
    {
      "description": "una consulta de RUC inválido",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/api/v1/ruc/20000000002"
      },
      "response": {
        "body": {
          "content": {
            "codigo": "RUC_INVALIDO",
            "mensaje": "Formato o dígito verificador incorrecto"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": ["application/json"]
        },
        "matchingRules": {
          "body": {
            "$.mensaje": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "una consulta de RUC válido",
      "pending": false,
      "providerStates": [
        {
          "name": "el RUC existe en el dataset ficticio"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/ruc/20000000109"
      },
      "response": {
        "body": {
          "content": {
            "condicion": "HABIDO",
            "direccion": "AV. FICTICIA 1",
            "estado": "ACTIVO",
            "razonSocial": "EMPRESA FICTICIA S.A.C.",
            "ruc": "20000000109",
            "ubigeo": "150101"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": ["application/json"]
        },
        "matchingRules": {
          "body": {
            "$.condicion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(HABIDO|NO HABIDO)$"
                }
              ]
            },
            "$.direccion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.estado": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(ACTIVO|BAJA DE OFICIO|BAJA DEFINITIVA|SUSPENSION TEMPORAL)$"
                }
              ]
            },
            "$.razonSocial": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.ubigeo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{6}$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "identidad-sim"
  }
}
