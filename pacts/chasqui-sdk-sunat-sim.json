{
  "consumer": {
    "name": "chasqui-sdk"
  },
  "interactions": [
    {
      "description": "el envío de una factura firmada",
      "pending": false,
      "request": {
        "body": {
          "content": {
            "contenido": "",
            "nombreArchivo": "20000000001-01-F001-1.zip"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": ["application/json"]
        },
        "matchingRules": {
          "body": {
            "$.contenido": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.nombreArchivo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{11}-\\d{2}-[A-Z0-9]{4}-\\d{1,8}\\.zip$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/comprobantes"
      },
      "response": {
        "body": {
          "content": {
            "cdr": "UEsDBA==",
            "codigo": "0",
            "estado": "aceptado",
            "id": "cmp_1",
            "mensaje": "La Factura numero F001-1, ha sido aceptada",
            "observaciones": []
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": ["application/json"]
        },
        "matchingRules": {
          "body": {
            "$.cdr": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.codigo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d+$"
                }
              ]
            },
            "$.estado": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(aceptado|observado|rechazado)$"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.mensaje": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "sunat-sim"
  }
}
