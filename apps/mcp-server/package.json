{
  "name": "@chasqui/mcp-server",
  "version": "0.1.0",
  "description": "Servidor MCP de Chasqui: herramientas para que agentes de IA prueben integraciones contra los simuladores",
  "private": true,
  "type": "module",
  "bin": {
    "chasqui-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "source": "./src/servidor.ts",
      "types": "./dist/servidor.d.ts",
      "default": "./dist/servidor.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx --conditions=source src/index.ts"
  },
  "dependencies": {
    "@chasqui/sdk": "workspace:*",
    "@chasqui/ubl-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chasqui/ecosistema": "workspace:*"
  }
}
