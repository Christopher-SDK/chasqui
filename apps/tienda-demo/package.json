{
  "name": "@chasqui/tienda-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --conditions=source src/index.ts"
  },
  "dependencies": {
    "@chasqui/sdk": "workspace:*",
    "@chasqui/telemetria": "workspace:*",
    "@chasqui/ubl-core": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chasqui/ecosistema": "workspace:*",
    "@chasqui/test-kit": "workspace:*"
  },
  "exports": {
    ".": {
      "source": "./src/servidor.ts",
      "types": "./dist/servidor.d.ts",
      "default": "./dist/servidor.js"
    }
  },
  "description": "Tienda de ejemplo que integra Chasqui con el SDK: valida RUC, cobra por QR y emite comprobantes"
}
