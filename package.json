{
  "name": "chasqui",
  "private": true,
  "description": "Laboratorio de pruebas para integraciones del ecosistema digital peruano",
  "author": "Christopher Arias <montreach.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prepare": "husky",
    "sunat:preparar": "node tools/sunat-oficial/descargar.mjs && python3 -m venv tools/sunat-oficial/.venv && tools/sunat-oficial/.venv/bin/pip install -q -r tools/sunat-oficial/requirements.txt",
    "mutation": "pnpm --filter @chasqui/ubl-core mutation",
    "dev": "pnpm --parallel --filter @chasqui/sunat-sim --filter @chasqui/panel dev",
    "e2e": "playwright test",
    "todo-en-uno": "pnpm --filter @chasqui/ecosistema start",
    "carga:preparar": "tsx --conditions=source carga/preparar.ts",
    "carga": "mkdir -p reports/carga && K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=reports/carga/reporte.html k6 run carga/chasqui.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@chasqui/ubl-core": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
