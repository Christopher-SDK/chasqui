{
  "name": "@chasqui/test-kit",
  "version": "0.1.0",
  "description": "Fixtures, builders y generadores de datos ficticios (RUC, DNI, personas) para probar integraciones con Chasqui",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pact": {
      "source": "./src/pact.ts",
      "types": "./dist/pact.d.ts",
      "default": "./dist/pact.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "fast-check": "^4.10.2",
    "@pact-foundation/pact": "^17.1.4"
  },
  "peerDependencies": {
    "@pact-foundation/pact": "^17.1.4"
  },
  "peerDependenciesMeta": {
    "@pact-foundation/pact": {
      "optional": true
    }
  }
}
