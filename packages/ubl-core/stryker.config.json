{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/validador/**/*.ts", "src/calculos.ts", "src/decimal.ts", "src/xml.ts"],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "stryker-incremental.json",
  "reporters": ["clear-text", "html", "json", "progress"],
  "htmlReporter": {
    "fileName": "../../reports/mutation/ubl-core/index.html"
  },
  "jsonReporter": {
    "fileName": "../../reports/mutation/ubl-core/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "inPlace": true,
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"]
}
